# ─── Server ───────────────────────────────────────
PORT=9000
ENVIRONMENT=development    # development | staging | production
BASE_URL=http://localhost:9000

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgres://keygate:keygate@localhost:5432/keygate?sslmode=disable

# ─── Security (required, generate with: openssl rand -hex 32) ───
JWT_SECRET=
LICENSE_SIGNING_KEY=
RELEASE_KEY_ENCRYPTION_KEY=
# Optional only while rotating the master key. Clear after every protected row
# has been re-encrypted and verified with RELEASE_KEY_ENCRYPTION_KEY.
RELEASE_KEY_ENCRYPTION_KEY_PREVIOUS=
LICENSE_KEY_STORAGE_MODE=dual  # dual | ciphertext_only
OTP_PEPPER=
METRICS_TOKEN=

# Setup is closed by default. Enable only for the first initialization request,
# use a strong one-time bootstrap secret, then set SETUP_ENABLED=false again.
SETUP_ENABLED=false
BOOTSTRAP_SECRET=

# Global HTTP safety limits.
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s

# ─── Payments (Stripe) ──────────────────────────
# Stripe: https://dashboard.stripe.com/apikeys
# Only STRIPE_SECRET_KEY is required. Webhook is auto-configured.
STRIPE_SECRET_KEY=

# ─── Email (optional; customer OTP returns OTP_UNAVAILABLE if absent) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Redis (required in production; no persistence is needed) ───
REDIS_URL=

# ─── Rate Limits (requests per minute) ───────────
RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
# Login codes per IP per HOUR. Deliberately tight: this endpoint mails
# an address the caller supplies, so a loose budget lets someone use
# your server (and your sending reputation) to spam third parties.
RATE_LIMIT_OTP_SEND=30

# ─── Webhooks ────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL=30s
WEBHOOK_HTTP_TIMEOUT=10s

# ─── Quotas ──────────────────────────────────────
QUOTA_WARNING_THRESHOLD=0.8

# ─── Admin Bootstrap ─────────────────────────────
# Comma-separated emails to auto-promote to admin on first login.
ADMIN_EMAILS=
